{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m-bissonette-hennix.github.io/still-pine/schemas/zenpack.schema.json",
  "title": "Still Pine Zenpack v1",
  "type": "object",
  "required": ["format", "id", "version", "title", "session"],
  "properties": {
    "format": {"const": "still-pine.zenpack/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "shortTitle": {"type": "string", "maxLength": 200},
    "tradition": {"type": "string", "maxLength": 500},
    "description": {"type": "string", "maxLength": 5000},
    "weeklyTeaching": {"type": "string", "maxLength": 5000},
    "weeklyTeachingNote": {"type": "string", "maxLength": 5000},
    "session": {
      "type": "object",
      "required": ["title", "stages"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/stage"}
        }
      }
    },
    "afterPractice": {
      "type": "object",
      "properties": {
        "logPrompt": {"type": "string", "maxLength": 1000},
        "inquiries": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 5000}}
      }
    },
    "study": {
      "type": "object",
      "properties": {
        "assignedReadingIds": {"type": "array", "maxItems": 200, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 200}},
        "contemplation": {"type": "string", "maxLength": 5000}
      }
    }
  },
  "$defs": {
    "visualFields": {
      "type": "object",
      "properties": {
        "imagePath": {"type": "string", "minLength": 1, "maxLength": 512},
        "imageAlt": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "dependentRequired": {"imagePath": ["imageAlt"]}
    },
    "cue": {
      "type": "object",
      "required": ["atSec", "text"],
      "properties": {
        "atSec": {"type": "integer", "minimum": 0},
        "text": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "substep": {
      "allOf": [
        {"$ref": "#/$defs/visualFields"},
        {
          "type": "object",
          "required": ["title", "durationSec"],
          "properties": {
            "title": {"type": "string", "minLength": 1, "maxLength": 200},
            "cue": {"type": "string", "maxLength": 500},
            "durationSec": {"type": "integer", "minimum": 1, "maximum": 43200}
          }
        }
      ]
    },
    "stage": {
      "allOf": [
        {"$ref": "#/$defs/visualFields"},
        {
          "type": "object",
          "required": ["id", "title", "durationSec", "instruction"],
          "properties": {
            "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
            "kind": {"type": "string", "maxLength": 500},
            "title": {"type": "string", "minLength": 1, "maxLength": 200},
            "durationSec": {"type": "integer", "minimum": 1, "maximum": 43200},
            "instruction": {"type": "string", "minLength": 1, "maxLength": 5000},
            "secondary": {"type": "string", "maxLength": 5000},
            "cues": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/cue"}},
            "substeps": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/substep"}}
          }
        }
      ]
    }
  }
}
